#!/bin/bash
# cckit — status + dashboard for your token-saving Claude Code stack.
#   cckit dashboard   collect real data and open the visual dashboard
#   cckit status      print a quick text status
#   cckit note "..."  add a note to your memory vault
set -e
# Resolve KIT_DIR through symlinks (cckit is symlinked onto PATH)
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
KIT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
MEM_DIR="${CCKIT_MEMORY:-$KIT_DIR/memory}"

have() { command -v "$1" >/dev/null 2>&1; }
running() { pgrep -f "$1" >/dev/null 2>&1 && echo true || echo false; }

collect() {
  # Real grepai token savings for the current project (falls back to zeros)
  local stats='{"total_queries":0,"tokens_saved":0,"savings_pct":0,"grep_tokens":0,"output_tokens":0,"by_command_type":{}}'
  if have grepai && [ -d .grepai ]; then
    stats="$(grepai stats --json 2>/dev/null || echo "$stats")"
  fi

  # Cross-session token usage parsed from ~/.claude/projects transcripts (also writes token-usage.md)
  local usage='{}'
  if have python3 && [ -f "$KIT_DIR/usage.py" ]; then
    usage="$(python3 "$KIT_DIR/usage.py" 2>/dev/null || echo '{}')"
  fi

  # grepai index status (files indexed)
  local indexed=0
  if have grepai && [ -d .grepai ]; then
    indexed="$(grepai status 2>/dev/null | grep -oiE '[0-9]+ (files|indexed)' | grep -oE '[0-9]+' | head -1 || echo 0)"
  fi

  # Ollama model present?
  local ollama_model="false"
  if have ollama; then ollama list 2>/dev/null | grep -q nomic-embed-text && ollama_model="true"; fi

  # MCP registered for Claude Code?
  local mcp="false"
  if have claude; then claude mcp list 2>/dev/null | grep -q "^grepai:" && mcp="true"; fi

  # Memory vault notes — prefer the project brain/, fall back to memory dir
  local NOTES_DIR="$MEM_DIR"
  [ -d brain ] && NOTES_DIR="$(pwd)/brain"
  local notes="[]"
  if [ -d "$NOTES_DIR" ]; then
    notes="$(cd "$NOTES_DIR" && for f in $(ls *.md 2>/dev/null); do
      title="$(head -1 "$f" | sed 's/^#* *//' | sed 's/"/\\"/g')"
      body="$(sed '1d' "$f" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{printf "%s\\n", $0}')"
      printf '{"file":"%s","title":"%s","body":"%s"},' "$f" "${title:-$f}" "$body"
    done | sed 's/,$//')"
    notes="[${notes}]"
  fi

  cat <<JSON
{
  "generatedAt": "$(date '+%Y-%m-%d %H:%M:%S')",
  "project": "$(basename "$(pwd)")",
  "tools": {
    "grepai":      { "installed": $(have grepai && echo true || echo false), "watching": $(running "grepai watch") },
    "astgrep":     { "installed": $(have ast-grep && echo true || echo false) },
    "repomix":     { "installed": $(have repomix && echo true || echo false) },
    "rtk":         { "installed": $(have rtk && echo true || echo false) },
    "ollama":      { "installed": $(have ollama && echo true || echo false), "running": $(running "ollama serve"), "model": $ollama_model },
    "obsidian":    { "installed": $([ -d "/Applications/Obsidian.app" ] && echo true || echo false) },
    "mcp":         { "registered": $mcp },
    "claudemd":    { "present": $([ -f CLAUDE.md ] || [ -f AGENTS.md ] && echo true || echo false) }
  },
  "index": { "files": ${indexed:-0} },
  "brain": { "present": $([ -d brain ] && echo true || echo false), "notes": $(ls brain/*.md 2>/dev/null | wc -l | tr -d ' ') },
  "grepai": $stats,
  "usage": $usage,
  "memory": $notes
}
JSON
}

# ── brain: scaffold an Obsidian-compatible project vault ────────────────────
make_brain() {
  local root="$(pwd)" name; name="$(basename "$root")"
  local BRAIN="$root/brain"
  mkdir -p "$BRAIN"

  # Auto-detect stack signals (best-effort, no network)
  local stack="" remote="" desc=""
  [ -f package.json ]    && stack="$stack- Node/JS (package.json)\n"
  [ -f tsconfig.json ]   && stack="$stack- TypeScript (tsconfig.json)\n"
  [ -f Cargo.toml ]      && stack="$stack- Rust (Cargo.toml)\n"
  [ -f go.mod ]          && stack="$stack- Go (go.mod)\n"
  [ -f requirements.txt ]||[ -f pyproject.toml ] && stack="$stack- Python\n"
  [ -f next.config.js ]||[ -f next.config.ts ]||[ -f next.config.mjs ] && stack="$stack- Next.js\n"
  [ -f CMakeLists.txt ]  && stack="$stack- C/C++ (CMake)\n"
  [ -z "$stack" ] && stack="- (fill in the languages/frameworks)\n"
  remote="$(git -C "$root" remote get-url origin 2>/dev/null || echo 'no git remote')"
  desc="$(head -5 README.md 2>/dev/null | grep -vE '^\s*#|^\s*$' | head -1 || echo 'One-line description of this project.')"

  _w() { # write a note only if it does not already exist (never clobber)
    [ -f "$BRAIN/$1" ] || printf '%b' "$2" > "$BRAIN/$1"
  }

  _w "_Home.md" "# 🧠 ${name} — Brain\n\n> Map of Content. This vault is the project's long-term memory. Open the \`brain/\` folder in Obsidian (or Foam/Logseq). Claude reads it every session via CLAUDE.md; grepai indexes it for semantic search.\n\n**${desc}**\n\n## Notes\n- [[Architecture]] — how the system fits together\n- [[Decisions]] — why we chose what we chose (ADR-style)\n- [[Glossary]] — domain terms & their meaning\n- [[Backlog]] — what's next / known TODOs\n- [[Sessions]] — running log of what changed and why\n- [[Exploration]] — cached findings from past subagent explorations (check before re-exploring)\n\n## At a glance\n- **Repo:** ${remote}\n- **Root:** \`${root}\`\n\n_Update these notes as the project evolves — cheap for you, huge token savings for every future Claude session._\n"

  _w "Architecture.md" "# Architecture\n\n_Linked from [[_Home]]._\n\n## Stack\n${stack}\n## Components\n- (describe the main modules/services and how they talk)\n\n## Data model\n- (key entities, tables, schemas)\n\n## Non-obvious decisions\n- See [[Decisions]]\n\n## Things NOT to re-derive\n> The whole point: write down what a fresh session would waste tokens rediscovering.\n"

  _w "Decisions.md" "# Decisions (ADR-style)\n\n_Linked from [[_Home]]._\n\nOne short entry per meaningful choice. Format:\n\n## $(date +%Y-%m-%d) — <decision title>\n- **Context:** why this came up\n- **Decision:** what we chose\n- **Why:** the reasoning / alternatives rejected\n- **Affects:** [[Architecture]]\n"

  _w "Glossary.md" "# Glossary\n\n_Linked from [[_Home]]._\n\n- **<term>** — definition, and where it lives in code.\n"

  _w "Backlog.md" "# Backlog\n\n_Linked from [[_Home]]._\n\n## Now\n- [ ] \n\n## Next\n- [ ] \n\n## Someday\n- [ ] \n"

  _w "Sessions.md" "# Session Log\n\n_Linked from [[_Home]]. Append newest at top. Use \`cckit note\` for quick captures._\n\n## $(date +%Y-%m-%d)\n- Brain initialized.\n"

  _w "Exploration.md" "# Exploration cache\n\n_Linked from [[_Home]]. The **explore** skill writes here. Subagents investigate in a throwaway context; their findings are distilled below so the same ground is never covered twice. CHECK THIS (or \`grepai search\`) before exploring anything._\n\n<!-- Format per entry:\n## YYYY-MM-DD — <question>\n- **Where looked:** dirs/files, grepai/ast-grep queries, dead-ends\n- **Findings:** answer with file:line refs\n- **Gotchas:** non-obvious things\n-->\n"

  # Minimal Obsidian config so the graph/wikilinks feel right on first open
  mkdir -p "$BRAIN/.obsidian"
  [ -f "$BRAIN/.obsidian/app.json" ] || printf '{\n  "alwaysUpdateLinks": true,\n  "newFileLocation": "current"\n}\n' > "$BRAIN/.obsidian/app.json"

  # Point CLAUDE.md at the brain (append once, never duplicate)
  if [ -f CLAUDE.md ] && ! grep -q "brain/_Home.md" CLAUDE.md 2>/dev/null; then
    printf '\n## Project brain\nRead **brain/_Home.md** first — it is the map of this project'"'"'s long-term memory (architecture, decisions, glossary, backlog). Update the relevant note when you learn or change something structural. grepai indexes brain/ so you can `grepai search` it.\n' >> CLAUDE.md
  fi

  # Drop a sensible .claudeignore so Claude never burns tokens reading junk.
  if [ ! -f "$root/.claudeignore" ]; then
    cat > "$root/.claudeignore" <<'IGN'
# Directories Claude should not read (token savers)
node_modules/
dist/
build/
.next/
out/
target/
__pycache__/
.venv/
venv/
coverage/
.git/
vendor/
.turbo/
.cache/
# Lockfiles + generated + binaries
*.lock
package-lock.json
pnpm-lock.yaml
yarn.lock
Cargo.lock
poetry.lock
*.min.js
*.min.css
*.map
*.generated.*
*.png
*.jpg
*.jpeg
*.gif
*.pdf
*.zip
*.woff*
IGN
    echo "   + .claudeignore (stops token-wasting reads of deps/build/binaries)"
  fi

  echo "🧠 Brain ready: $BRAIN"
  echo "   Open in Obsidian:  open -a Obsidian '$BRAIN'   (or File → Open folder as vault)"
  echo "   Notes: _Home, Architecture, Decisions, Glossary, Backlog, Sessions"
}

case "${1:-dashboard}" in
  brain)
    make_brain ;;
  usage)
    if have python3 && [ -f "$KIT_DIR/usage.py" ]; then
      python3 "$KIT_DIR/usage.py" >/dev/null && echo "Wrote ~/.claude/token-usage.md" && command -v bat >/dev/null && bat ~/.claude/token-usage.md || sed -n '1,12p' ~/.claude/token-usage.md
    else echo "needs python3"; fi ;;
  status)
    collect | grep -E '"(installed|watching|running|model|registered|present|tokens_saved|savings_pct|total_queries)"' ;;
  note)
    shift; title="$*"; [ -z "$title" ] && { echo "usage: cckit note \"your note\""; exit 1; }
    mkdir -p "$MEM_DIR"; f="$MEM_DIR/$(date +%Y%m%d-%H%M%S).md"
    printf "# %s\n\n_%s_\n\n" "$title" "$(date)" > "$f"
    echo "saved $f (edit to add detail)" ;;
  dashboard|"")
    data="$(collect)"
    out="$KIT_DIR/dashboard/dashboard.html"
    # Inject real data into the template. Python does a literal string replace of the
    # {}-terminated token — robust against any JSON content (paths, quotes, newlines)
    # where sed's delimiter/escaping was fragile.
    DATA_JSON="$data" python3 - "$KIT_DIR/dashboard/template.html" "$out" <<'PY'
import os, sys
tpl, out = sys.argv[1], sys.argv[2]
html = open(tpl).read().replace("/*__DATA__*/{}", os.environ["DATA_JSON"], 1)
open(out, "w").write(html)
PY
    echo "Dashboard: $out"
    open "$out" 2>/dev/null || xdg-open "$out" 2>/dev/null || echo "open it manually" ;;
  *) echo "usage: cckit [dashboard|status|note|brain|usage]"
     echo "  dashboard  collect real data + open the visual dashboard"
     echo "  status     quick text status of the token stack"
     echo "  note \"..\"  add a timestamped note to the memory vault"
     echo "  brain      scaffold an Obsidian project vault (brain/) here"
     echo "  usage      write ~/.claude/token-usage.md (cross-session tokens)" ;;
esac
